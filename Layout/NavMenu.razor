@inject NavigationManager navigation
@inject IJSRuntime JsRuntime

<MudSpacer/>

<MudButton Size="Size.Large"
           OnClick="DownloadCurriculum"
           EndIcon="@Icons.Custom.FileFormats.FilePdf"
           Color="Color.Inherit">
    Currículo
</MudButton>

<MudIconButton
    Size="Size.Medium"
    OnClick="() => OnDarkModeToggle.InvokeAsync()"
    Icon="@(IsDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
    Color="Color.Inherit"
/>

<MudIconButton
    Size="Size.Medium"
    OnClick="OpenAccount"
    Icon="@Icons.Material.Filled.AccountCircle"
    Color="Color.Inherit"
    AriaLabel="Conta"
/>

@code
{
    [Parameter]
    public EventCallback OnDarkModeToggle { get; set; }

    [Parameter]
    public bool IsDarkMode { get; set; }

    void DownloadCurriculum()
    {
        JsRuntime.InvokeVoidAsync("downloadFileFromUrl", "Paulo.pdf",
            "https://drive.google.com/uc?export=download&id=1QsnOIZzty-70RfSCt05uqzXgCkZnsL0I");
    }

    void OpenAccount()
    {
        // Intencionalmente vazio por enquanto
    }
}
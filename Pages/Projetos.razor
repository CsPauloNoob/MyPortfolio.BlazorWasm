@* File: Pages/Projetos.razor *@
@page "/Projetos"
@using MudBlazor
@using System

<MudText Align="Align.Center" Class="mb-2" Typo="Typo.h3">Projetos e Portfólio</MudText>
<MudText Align="Align.Center" Class="mb-6" Typo="Typo.subtitle1">Projetos selecionados — clique para abrir no GitHub</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_filter"
                          Placeholder="Buscar por nome ou descrição..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="w-100" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex justify-end align-center">
            <MudText Typo="Typo.caption" Class="mr-2">Total:</MudText>
            <MudBadge Color="Color.Primary" Content="@FilteredProjects.Count" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudGrid Gutter="3">
    @if (!FilteredProjects.Any())
    {
        <MudItem xs="12">
            <MudAlert Severity="Severity.Info" Dense="true">Nenhum projeto encontrado.</MudAlert>
        </MudItem>
    }
    else
    {
        @foreach (var proj in FilteredProjects)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Class="project-card" Outlined="true" Elevation="2">
                    <MudCardMedia Image="@GetImageUrl(proj.Name)" Height="150" />

                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@proj.Name</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>

                    <MudCardContent>

                        <MudText Typo="Typo.caption" Class="mt-2">Autor: <b>@proj.Author</b></MudText>

                        <div class="chips-row">
                            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Code">Projeto</MudChip>
                            <MudChip T="string" Color="Color.Default" StartIcon="@Icons.Material.Filled.Tag">Estudo</MudChip>
                        </div>
                        
                        <MudText Typo="Typo.body2">
                            @Truncate(proj.Description, 180)
                        </MudText>
                        
                    </MudCardContent>

                    <MudCardActions Class="d-flex justify-space-between align-center">
                        <div></div> <!-- mantém espaço à esquerda se necessário -->

                        <div class="d-flex">
                            <MudTooltip Text="Abrir no GitHub">
                                <MudIconButton Icon="@Icons.Custom.Brands.GitHub"
                                               Color="Color.Primary"
                                               Href="@proj.Link"
                                               Target="_blank" />
                            </MudTooltip>

                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Href="@proj.Link"
                                       Target="_blank"
                                       StartIcon="@Icons.Material.Filled.OpenInNew">
                                Ver
                            </MudButton>
                        </div>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    }
</MudGrid>

@code {
    private string _filter = string.Empty;
    public List<RepositorioGithub> MeusProjetos { get; private set; } = new();

    private List<RepositorioGithub> FilteredProjects => MeusProjetos
        .Where(p =>
            string.IsNullOrWhiteSpace(_filter)
            || (p.Name?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false)
            || (p.Description?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToList();

    protected override void OnParametersSet()
    {
        // mantém sua lógica atual para carregar projetos (sincrona no exemplo original)
        List<RepositorioGithub> repositorios = new RepositorioGithub().DefaultProjetos();
        MeusProjetos = repositorios ?? new();
    }

    private static string Truncate(string? text, int max)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        return text.Length <= max ? text : text.Substring(0, max).TrimEnd() + "…";
    }

    private static string GetImageUrl(string? seed)
    {
        var s = string.IsNullOrWhiteSpace(seed) ? "placeholder" : Uri.EscapeDataString(seed);
        return $"https://picsum.photos/seed/{s}/600/300";
    }
}